<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="鼠鼠cleaner" Width="1040" Height="760" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#FFF6DC"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        AutomationProperties.Name="鼠鼠 Cleaner 安全整理工具">
  <Window.Resources>
    <sys:String x:Key="TechnicalDetailsText">技术详情</sys:String>
    <sys:String x:Key="ErrorDetailsText">查看技术详情</sys:String>
    <SolidColorBrush x:Key="Ink" Color="#211D16"/>
    <SolidColorBrush x:Key="Cream" Color="#FFF6DC"/>
    <SolidColorBrush x:Key="Paper" Color="#FFFFF8"/>
    <SolidColorBrush x:Key="FantasyYellow" Color="#FFD21F"/>
    <SolidColorBrush x:Key="Muted" Color="#6E675D"/>
    <SolidColorBrush x:Key="Danger" Color="#B83A2D"/>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="MinWidth" Value="156"/><Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="18,0"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Background" Value="{StaticResource FantasyYellow}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="MinWidth" Value="120"/><Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#F0E5C8"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#CDBF9D"/>
    </Style>
    <Style x:Key="StageCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="#D8CBAA"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="228"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="4,0,4,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="TitleMain" Text="鼠鼠cleaner" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="TitleSub" Text="识别可以宽，执行必须窄" Foreground="{StaticResource Muted}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock x:Name="PrivilegeText" Text="普通权限" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="BtnLang" Content="EN" Style="{StaticResource SecondaryButton}" MinWidth="52" AutomationProperties.Name="切换语言"/>
      </StackPanel>
    </Grid>
    <UniformGrid x:Name="ComicRail" Grid.Row="1" Columns="4" MinHeight="220">
      <Border x:Name="StageCard1" Style="{StaticResource StageCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="ImgStage1" Stretch="Uniform" AutomationProperties.Name="轻盈幻想阶段插图"/><TextBlock x:Name="StageLabel1" Grid.Row="1" Text="1 轻盈幻想" FontWeight="Bold" Margin="2,6,2,0"/></Grid></Border>
      <Border x:Name="StageCard2" Style="{StaticResource StageCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="ImgStage2" Stretch="Uniform" AutomationProperties.Name="看清现实阶段插图"/><TextBlock x:Name="StageLabel2" Grid.Row="1" Text="2 看清现实" FontWeight="Bold" Margin="2,6,2,0"/></Grid></Border>
      <Border x:Name="StageCard3" Style="{StaticResource StageCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="ImgStage3" Stretch="Uniform" AutomationProperties.Name="谨慎整理阶段插图"/><TextBlock x:Name="StageLabel3" Grid.Row="1" Text="3 谨慎整理" FontWeight="Bold" Margin="2,6,2,0"/></Grid></Border>
      <Border x:Name="StageCard4" Style="{StaticResource StageCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="ImgStage4" Stretch="Uniform" AutomationProperties.Name="幻想落地阶段插图"/><TextBlock x:Name="StageLabel4" Grid.Row="1" Text="4 幻想落地" FontWeight="Bold" Margin="2,6,2,0"/></Grid></Border>
    </UniformGrid>
    <Border Grid.Row="2" Margin="4,10,4,4" Padding="20" Background="{StaticResource Paper}" CornerRadius="14" BorderBrush="#D8CBAA" BorderThickness="1">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="StateHeader"><TextBlock x:Name="StateTitle" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
          <TextBlock x:Name="StateSubtitle" Margin="0,4,0,12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer x:Name="StateBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <StackPanel x:Name="IdlePanel"><TextBlock x:Name="IdleBodyText" Text="扫描只读，不会修改系统。" Margin="0,0,0,16"/><DockPanel LastChildFill="False"><Button x:Name="BtnStartScan" Content="开始安全扫描" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" IsDefault="True" AutomationProperties.Name="开始安全扫描"/></DockPanel></StackPanel>
          <StackPanel x:Name="ScanningPanel" Visibility="Collapsed"><ProgressBar x:Name="ScanProgress" Height="8" IsIndeterminate="True"/><TextBlock x:Name="ScanPhaseText" Text="正在检查系统项目" Margin="0,12,0,8"/><TextBox x:Name="ScanOutput" IsReadOnly="True" Height="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
          <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
            <TextBlock x:Name="ResultStatusText" Text="扫描完成，发现问题" FontSize="18" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
              <TextBlock x:Name="ResultHeadlinePrefix" Text="抓到 " FontSize="38" FontWeight="Black" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ResultHeadlineCount" Text="0" FontSize="50" FontWeight="Black" Foreground="{StaticResource FantasyYellow}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ResultHeadlineSuffix" Text=" 个偷偷常驻的后台" FontSize="38" FontWeight="Black" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ResultSummaryText" FontSize="21" FontWeight="SemiBold" AutomationProperties.Name="扫描结果摘要"/>
            <Border Height="1" Background="#B8AD92" Margin="0,12,0,10"/>
            <TextBlock x:Name="ResultsNoMutationText" Text="目前尚未修改任何内容。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,10">
              <Button x:Name="BtnOpenReview" Content="查看处理建议" Style="{StaticResource PrimaryButton}" MinWidth="260" Height="56" FontSize="18" IsDefault="True" AutomationProperties.Name="查看处理建议"/>
              <Button x:Name="BtnSkipReview" Content="这次先不处理" Style="{StaticResource SecondaryButton}" MinWidth="220" Height="56" FontSize="17" Margin="14,0,0,0" AutomationProperties.Name="这次先不处理"/>
            </StackPanel>
            <Expander x:Name="ResultsEvidenceExpander" Header="专业证据与服务名称（点击展开）" IsExpanded="False" Margin="0,8,0,0">
              <TextBlock x:Name="ResultEvidenceText" FontFamily="Consolas" TextWrapping="Wrap" Margin="16,8,0,0"/>
            </Expander>
          </StackPanel>
          <Grid x:Name="ReviewPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Button x:Name="BtnSelectAll" Content="选择全部安全项" Style="{StaticResource SecondaryButton}"/><Button x:Name="BtnClearAll" Content="清空选择" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"/></StackPanel>
            <ListBox x:Name="PendingList" Grid.Row="1" MaxHeight="70" Margin="0,8" Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Continue"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E2D7BC" BorderThickness="0,0,0,1" Padding="6"><StackPanel><DockPanel><CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanExecute}" VerticalAlignment="Center"/><TextBlock Text="{Binding name_cn}" FontWeight="Bold" Margin="8,0"/><TextBlock Text="{Binding action_label}" Foreground="#6E675D"/></DockPanel><TextBlock Text="{Binding reason_cn}" TextWrapping="Wrap" Margin="24,4,0,0"/><Expander Header="{DynamicResource TechnicalDetailsText}" Margin="24,4,0,0"><TextBlock Text="{Binding matcher_detail}" FontFamily="Consolas" TextWrapping="Wrap"/></Expander></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <DockPanel Grid.Row="2"><TextBlock x:Name="ReviewBoundaryText" Text="观察项不会自动执行；执行前将再次验证。" VerticalAlignment="Center"/><Button x:Name="BtnExecute" Content="处理已选择项目" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" AutomationProperties.Name="处理已选择项目"/></DockPanel>
            <TextBlock x:Name="SuspiciousBoundaryText" Grid.Row="3" Text="可疑进程：只结束本次进程，不删除文件或关闭自启。" FontWeight="SemiBold" Margin="0,18,0,6" TextWrapping="Wrap"/>
            <ListBox x:Name="SuspiciousList" Grid.Row="4" MaxHeight="35" Margin="0,2,0,4" Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Continue"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E2D7BC" BorderThickness="0,0,0,1" Padding="4"><StackPanel><DockPanel><CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanStop}" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,0"/><TextBlock Text="{Binding PidLabel}" Foreground="#6E675D"/></DockPanel><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="24,2,0,0"/><TextBlock Text="{Binding StopBlockReason}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="24,2,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <DockPanel Grid.Row="5"><TextBlock x:Name="SuspiciousSelectionHint" Text="默认不勾选；执行前会复核 PID、名称、路径和启动时间。" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="BtnStopProcesses" Content="一次性结束已选进程" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" IsEnabled="False" AutomationProperties.Name="一次性结束已选进程"/></DockPanel>
          </Grid>
          <StackPanel x:Name="ExecutingPanel" Visibility="Collapsed"><TextBlock x:Name="ExecutingBodyText" Text="正在逐项处理；每项均会备份并复核。"/><ListBox x:Name="ExecutionList" Margin="0,10" DisplayMemberPath="StateLabel"/></StackPanel>
          <StackPanel x:Name="CompletedPanel" Visibility="Collapsed"><TextBlock x:Name="CompletedSummaryText" FontSize="18" FontWeight="Bold" AutomationProperties.Name="处理或恢复结果摘要"/><ListBox x:Name="CompletedList" DisplayMemberPath="StateLabel"/><DockPanel Margin="0,12,0,0" LastChildFill="False"><Button x:Name="BtnRescan" Content="重新扫描" Style="{StaticResource PrimaryButton}" IsDefault="True" AutomationProperties.Name="重新扫描"/><Button x:Name="BtnRestore" Content="恢复最近处理" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="恢复最近处理"/></DockPanel></StackPanel>
          <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"><TextBlock x:Name="ErrorSummaryText" Foreground="{StaticResource Danger}" FontWeight="Bold" AutomationProperties.Name="错误摘要"/><TextBlock x:Name="ErrorMutationText" Margin="0,6,0,12"/><Expander Header="{DynamicResource ErrorDetailsText}"><TextBox x:Name="ErrorDetailText" IsReadOnly="True" Height="120" TextWrapping="Wrap"/></Expander><DockPanel LastChildFill="False"><Button x:Name="BtnRetry" Content="重试" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" IsDefault="True" AutomationProperties.Name="重试"/></DockPanel></StackPanel>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
